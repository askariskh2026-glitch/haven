<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    
    <title>Haven</title>

    <style>
        *{
          margin: 0;
          padding: 0;
          box-sizing: border-box;  
        }

        body {
            font-family: Arial, sans-serif;
            background: aliceblue;
        }

        .page {
           width:100%;
           min-height: 100vh;
           display: flex;
           justify-content: center;
           padding: 20px; 
        }

        .canva-container {
            position: relative;
            width: 100%;
            max-width: 1400px;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            background: white;
        }

        .canva-container iframe {
            position: absolute;
            top:0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        @media (max-width: 600px) {
            .page {
                padding: 0;
                align-items: flex-start;
            }

            .canva-container {
                border-radius: 0;
            }
        }
    </style>
</head>

<body>

    <div class="page">
        <div class="canva-container">
            <iframe
               src="https://www.canva.com/design/DAHXaaWjFtc/zyopgcoECjiKLhh7NbuHrQ/view?embed"
               title="Haven Website"
               allowfullscreen>
            </iframe>
        </div>
    </div>
</body>
</html>            
